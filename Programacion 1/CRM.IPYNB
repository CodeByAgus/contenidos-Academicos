    "# Creación de Matrices inicializadas en cero (12 meses)\n",
    "\n",
    "# 1. Matriz de Ventas por Producto \n",
    "# (Filas: cantidad de productos, Columnas: 12 meses)\n",
    "matriz_productos = [[0 for columna in range(12)] for fila in range(len(productos))]\n",
    "\n",
    "# 2. Matriz de Ventas por Vendedor \n",
    "# (Filas: cantidad de vendedores, Columnas: 12 meses)\n",
    "matriz_vendedores = [[0 for columna in range(12)] for fila in range(len(vendedores))]\n",
    "\n",
    "# Impresión de los resultados (le agregué el nombre al lado para que se vea claro)\n",
    "print(\"=== MATRIZ DE VENTAS POR PRODUCTO ===\")\n",
    "for i in range(len(productos)):\n",
    "    print(f\"{productos[i]}: {matriz_productos[i]}\")\n",
    "\n",
    "print(\"\\n=== MATRIZ DE VENTAS POR VENDEDOR ===\")\n",
    "for i in range(len(vendedores)):\n",
    "    print(f\"{vendedores[i]}: {matriz_vendedores[i]}\")"
   ]
