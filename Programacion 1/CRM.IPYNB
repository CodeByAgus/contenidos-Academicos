    "# Lógica Funcional del CRM\n",
    "\n",
    "def menu_admin():\n",
    "    while True:\n",
    "        print(\"\\n=== MENÚ DE ADMINISTRADOR ===\")\n",
    "        print(\"1. Modificar lista de vendedores (Agregar / Eliminar)\")\n",
    "        print(\"2. Modificar lista de productos (Agregar / Eliminar)\")\n",
    "        print(\"3. Imprimir matrices de productos\")\n",
    "        print(\"4. Imprimir matrices de vendedores\")\n",
    "        print(\"5. Revisar total anual de ventas\")\n",
    "        print(\"6. Revisar promedio de ventas mensuales\")\n",
    "        print(\"7. Salir\")\n",
    "        \n",
    "        opcion = input(\"Seleccione una opción (1-7): \")\n",
    "        \n",
    "        if opcion == '1':\n",
    "            print(\"\\n-- Modificar Vendedores --\")\n",
    "            print(\"1. Agregar\")\n",
    "            print(\"2. Eliminar\")\n",
    "            sub_op = input(\"Seleccione 1 o 2: \")\n",
    "            \n",
    "            if sub_op == '1':\n",
    "                nuevo = input(\"Ingrese el nombre del nuevo vendedor: \").capitalize()\n",
    "                vendedores.append(nuevo)\n",
    "                matriz_vendedores.append([0 for _ in range(12)]) # Agrega una nueva fila de 12 ceros\n",
    "                print(f\"Vendedor '{nuevo}' agregado con éxito.\")\n",
    "                \n",
    "            elif sub_op == '2':\n",
    "                eliminar = input(\"Ingrese el nombre del vendedor a eliminar: \").capitalize()\n",
    "                if eliminar in vendedores:\n",
    "                    seguro = input(f\"¿Está seguro que desea eliminar a {eliminar} y todos sus datos? (S/N): \").upper()\n",
    "                    if seguro == 'S':\n",
    "                        indice = vendedores.index(eliminar)\n",
    "                        vendedores.pop(indice) # Elimina de la lista\n",
    "                        matriz_vendedores.pop(indice) # Elimina la fila de la matriz\n",
    "                        print(f\"Vendedor '{eliminar}' eliminado del sistema.\")\n",
    "                    else:\n",
    "                        print(\"Operación cancelada.\")\n",
    "                else:\n",
    "                    print(f\"Error: El vendedor '{eliminar}' no existe en el sistema.\")\n",
    "            else:\n",
    "                print(\"Opción no válida.\")\n",
    "\n",
    "        elif opcion == '2':\n",
    "            print(\"\\n-- Modificar Productos --\")\n",
    "            print(\"1. Agregar\")\n",
    "            print(\"2. Eliminar\")\n",
    "            sub_op = input(\"Seleccione 1 o 2: \")\n",
    "            \n",
    "            if sub_op == '1':\n",
    "                nuevo = input(\"Ingrese el nombre del nuevo producto: \").capitalize()\n",
    "                productos.append(nuevo)\n",
    "                matriz_productos.append([0 for _ in range(12)]) # Agrega una nueva fila de 12 ceros\n",
    "                print(f\"Producto '{nuevo}' agregado con éxito.\")\n",
    "                \n",
    "            elif sub_op == '2':\n",
    "                eliminar = input(\"Ingrese el nombre del producto a eliminar: \").capitalize()\n",
    "                if eliminar in productos:\n",
    "                    seguro = input(f\"¿Está seguro que desea eliminar el producto {eliminar}? (S/N): \").upper()\n",
    "                    if seguro == 'S':\n",
    "                        indice = productos.index(eliminar)\n",
    "                        productos.pop(indice)\n",
    "                        matriz_productos.pop(indice)\n",
    "                        print(f\"Producto '{eliminar}' eliminado del sistema.\")\n",
    "                    else:\n",
    "                        print(\"Operación cancelada.\")\n",
    "                else:\n",
    "                    print(f\"Error: El producto '{eliminar}' no existe.\")\n",
    "            else:\n",
    "                print(\"Opción no válida.\")\n",
    "\n",
    "        elif opcion == '3':\n",
    "            print(\"\\n--- MATRIZ DE PRODUCTOS ---\")\n",
    "            for i in range(len(productos)):\n",
    "                print(f\"{productos[i]}: {matriz_productos[i]}\")\n",
    "\n",
    "        elif opcion == '4':\n",
    "            print(\"\\n--- MATRIZ DE VENDEDORES ---\")\n",
    "            for i in range(len(vendedores)):\n",
    "                print(f\"{vendedores[i]}: {matriz_vendedores[i]}\")\n",
    "\n",
    "        elif opcion == '5':\n",
    "            # Suma total de toda la matriz de vendedores\n",
    "            total_anual = sum(sum(fila) for fila in matriz_vendedores)\n",
    "            print(f\"\\nEl total anual de ventas de toda la empresa es: ${total_anual}\")\n",
    "\n",
    "        elif opcion == '6':\n",
    "            total_anual = sum(sum(fila) for fila in matriz_vendedores)\n",
    "            meses_totales = len(vendedores) * 12\n",
    "            if meses_totales > 0:\n",
    "                promedio = total_anual / meses_totales\n",
    "                print(f\"\\nEl promedio de ventas mensuales por vendedor es: ${promedio:.2f}\")\n",
    "            else:\n",
    "                print(\"\\nNo hay vendedores para calcular el promedio.\")\n",
    "\n",
    "        elif opcion == '7':\n",
    "            print(\"Saliendo del menú administrador...\")\n",
    "            break\n",
    "        else:\n",
    "            print(\"Opción inválida. Intente nuevamente.\")\n",
    "\n",
    "\n",
    "def menu_vendedor():\n",
    "    nombre = input(\"Por favor, ingrese su nombre de vendedor: \").capitalize()\n",
    "    \n",
    "    if nombre in vendedores:\n",
    "        indice_vend = vendedores.index(nombre) # Obtenemos la fila que le corresponde\n",
    "        \n",
    "        while True:\n",
    "            print(f\"\\n=== MENÚ DE VENDEDOR: {nombre} ===\")\n",
    "            print(\"1. Modificar mis ingresos mensuales\")\n",
    "            print(\"2. Revisar mi promedio de ventas mensuales\")\n",
    "            print(\"3. Revisar mi total anual\")\n",
    "            print(\"4. Añadir nuevos productos\")\n",
    "            print(\"5. Añadir proyecciones en base al promedio mensual\")\n",
    "            print(\"6. Revisar el producto más vendido\")\n",
    "            print(\"7. Salir\")\n",
    "            \n",
    "            opcion = input(\"Seleccione una opción (1-7): \")\n",
    "            \n",
    "            if opcion == '1':\n",
    "                mes = int(input(\"Ingrese el número del mes a modificar (1-12): \"))\n",
    "                if 1 <= mes <= 12:\n",
    "                    nuevo_valor = int(input(f\"Ingrese el nuevo monto para el mes {mes}: $\"))\n",
    "                    matriz_vendedores[indice_vend][mes - 1] = nuevo_valor\n",
    "                    print(\"Ingreso actualizado exitosamente.\")\n",
    "                else:\n",
    "                    print(\"Mes inválido. Debe ser entre 1 y 12.\")\n",
    "\n",
    "            elif opcion == '2':\n",
    "                promedio = sum(matriz_vendedores[indice_vend]) / 12\n",
    "                print(f\"\\nTu promedio de ventas mensuales es: ${promedio:.2f}\")\n",
    "\n",
    "            elif opcion == '3':\n",
    "                total = sum(matriz_vendedores[indice_vend])\n",
    "                print(f\"\\nTu total de ventas anuales es: ${total}\")\n",
    "\n",
    "            elif opcion == '4':\n",
    "                nuevo = input(\"Ingrese el nombre del nuevo producto: \").capitalize()\n",
    "                productos.append(nuevo)\n",
    "                matriz_productos.append([0 for _ in range(12)]) \n",
    "                print(f\"Producto '{nuevo}' agregado al catálogo de la empresa.\")\n",
    "\n",
    "            elif opcion == '5':\n",
    "                promedio = sum(matriz_vendedores[indice_vend]) / 12\n",
    "                meses_proy = int(input(\"¿Para cuántos meses a futuro desea calcular la proyección?: \"))\n",
    "                proyeccion = promedio * meses_proy\n",
    "                print(f\"\\nSi mantienes tu promedio actual (${promedio:.2f}), tu proyección para los próximos {meses_proy} meses es de: ${proyeccion:.2f}\")\n",
    "\n",
    "            elif opcion == '6':\n",
    "                if len(productos) > 0:\n",
    "                    # Sumamos las ventas anuales de cada producto para encontrar el mayor\n",
    "                    ventas_por_producto = [sum(fila) for fila in matriz_productos]\n",
    "                    max_ventas = max(ventas_por_producto)\n",
    "                    indice_max = ventas_por_producto.index(max_ventas)\n",
    "                    print(f\"\\nEl producto más vendido es '{productos[indice_max]}' con un total de ${max_ventas} unidades/pesos.\")\n",
    "                else:\n",
    "                    print(\"No hay productos en el sistema.\")\n",
    "\n",
    "            elif opcion == '7':\n",
    "                print(\"Saliendo de tu sesión de vendedor...\")\n",
    "                break\n",
    "            else:\n",
    "                print(\"Opción inválida. Intente nuevamente.\")\n",
    "    else:\n",
    "        print(f\"\\nAcceso denegado: El nombre '{nombre}' no se encuentra en la lista de vendedores.\")\n",
    "\n",
    "# Bloque principal de ejecución (Ciclo infinito para que el programa no muera de inmediato)\n",
    "while True:\n",
    "    print(\"\\n\" + \"=\"*30)\n",
    "    print(\"--- SISTEMA CRM PRINCIPAL ---\")\n",
    "    print(\"=\"*30)\n",
    "    print(\"1. Acceso Administrador\")\n",
    "    print(\"2. Acceso Vendedor\")\n",
    "    print(\"3. Apagar Sistema\")\n",
    "    \n",
    "    tipo_usuario = input(\"Ingrese su opción (1, 2 o 3): \")\n",
    "    \n",
    "    if tipo_usuario == '1':\n",
    "        menu_admin()\n",
    "    elif tipo_usuario == '2':\n",
    "        menu_vendedor()\n",
    "    elif tipo_usuario == '3':\n",
    "        print(\"Apagando el sistema CRM... ¡Hasta luego!\")\n",
    "        break\n",
    "    else:\n",
    "        print(\"Opción inválida. Por favor, ingrese 1, 2 o 3.\") "
   ]
